<?xml version="1.0" encoding="utf-8"?>
<!-- Admin: Respuestas de un participante (detalle de la partida) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cira_fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/encabezado_admin" />

    <!-- Fecha a la izquierda, puntaje a la derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cira_texto_suave"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPuntaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_etiqueta"
            android:backgroundTint="@color/cira_verde_claro"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/cira_verde_oscuro"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaRespuestas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <ProgressBar
            android:id="@+id/cargando"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/cira_verde" />
    </FrameLayout>
</LinearLayout>