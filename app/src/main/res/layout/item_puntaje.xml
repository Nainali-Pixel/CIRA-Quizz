<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de "Mejores Puntajes" (también sirve para el Historial) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_redondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/txtPosicion"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_redondo"
        android:backgroundTint="@color/cira_verde_claro"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/cira_texto"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Ana"
        android:textColor="@color/cira_texto"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtPuntos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9"
        android:textColor="@color/cira_verde"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>