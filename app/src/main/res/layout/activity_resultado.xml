<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 4: Quiz finalizado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cira_fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Encabezado -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="16dp"
        android:text="¡Quiz Finalizado!"
        android:textColor="@color/cira_texto"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Anillo con trofeo -->
            <TextView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_anillo"
                android:gravity="center"
                android:text="🏆"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/txtPuntaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Puntaje: 8 / 10"
                android:textColor="@color/cira_texto"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Formulario para guardar -->
            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_borde"
                android:hint="Ingresa tu nombre"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:paddingHorizontal="16dp"
                android:textColor="@color/cira_texto" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cira_verde"
                android:text="Guardar en Historial"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <!-- Reintentar / Volver al menú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReintentar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_borde"
                    android:gravity="center"
                    android:text="Reintentar"
                    android:textColor="@color/cira_texto"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnVolverMenu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_borde"
                    android:gravity="center"
                    android:text="Volver al menú"
                    android:textColor="@color/cira_texto"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnComentario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="6dp"
                android:text="💬  Dejar un comentario"
                android:textColor="@color/cira_azul"
                android:textStyle="bold" />

            <!-- Mejores puntajes (se llenan desde Firestore) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mejores Puntajes"
                android:textColor="@color/cira_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/listaMejores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtSinPuntajes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aún no hay puntajes guardados"
                android:textColor="@color/cira_texto_suave"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>