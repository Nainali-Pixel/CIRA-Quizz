<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 3: Quiz -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cira_fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado: cerrar + progreso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_redondo"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/cira_texto"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtProgreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pregunta 1/10"
                android:textColor="@color/cira_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/barraProgreso"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="6dp"
                android:max="10"
                android:progress="1"
                android:progressBackgroundTint="@color/cira_verde_claro"
                android:progressTint="@color/cira_verde" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicador de carga mientras se leen las preguntas -->
    <ProgressBar
        android:id="@+id/cargando"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:indeterminateTint="@color/cira_verde" />

    <!-- Contenido de la pregunta (oculto hasta que cargue) -->
    <LinearLayout
        android:id="@+id/contenidoPregunta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtPregunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="¿En qué contenedor va este residuo?"
            android:textColor="@color/cira_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtImagen"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_redondo"
            android:elevation="2dp"
            android:gravity="center"
            android:text="🥫"
            android:textSize="96sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnOpcionA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cira_verde"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="A    Cartón"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnOpcionB"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cira_azul"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="B    Aluminio / Latas"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnOpcionC"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cira_amarillo"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="C    Plástico"
            android:textAllCaps="false"
            android:textColor="@color/cira_texto"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <Button
            android:id="@+id/btnOpcionD"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/cira_gris"
            android:gravity="start|center_vertical"
            android:paddingStart="20dp"
            android:text="D    Otros"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>