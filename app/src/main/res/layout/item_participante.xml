<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de Respuestas de participantes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_redondo"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtInicial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_redondo"
        android:backgroundTint="@color/cira_verde_claro"
        android:gravity="center"
        android:textColor="@color/cira_verde_oscuro"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cira_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cira_texto_suave"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtPuntaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_etiqueta"
        android:backgroundTint="@color/cira_verde_claro"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/cira_verde_oscuro"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_chevron"
        app:tint="@color/cira_texto" />
</LinearLayout>
