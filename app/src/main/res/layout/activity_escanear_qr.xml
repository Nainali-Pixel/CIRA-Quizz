<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 2: Escanear QR -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#37474F"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Encabezado con botón volver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_redondo"
            android:backgroundTint="#33FFFFFF"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Escanear QR"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Zona del marco: al tocarla se abre la cámara -->
    <LinearLayout
        android:id="@+id/zonaEscaneo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_marco_qr"
            android:gravity="center"
            android:text="📷"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/txtInstruccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_redondo"
            android:backgroundTint="#CC000000"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Toca aquí para escanear el QR del contenedor"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hoja inferior con el resultado (oculta hasta escanear) -->
    <LinearLayout
        android:id="@+id/hojaResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hoja"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtEmoji"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_redondo"
            android:backgroundTint="@color/cira_fondo"
            android:gravity="center"
            android:text="📦"
            android:textSize="72sp" />

        <TextView
            android:id="@+id/txtNombreResiduo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Caja de cereal"
            android:textColor="@color/cira_texto"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtContenedor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Contenedor: Cartón"
            android:textColor="@color/cira_verde"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtConsejo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Aplánala antes de depositarla."
            android:textColor="@color/cira_texto_suave"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEscanearOtro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/cira_verde"
            android:text="🔄  Escanear otro"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />
    </LinearLayout>
</LinearLayout>