<?xml version="1.0" encoding="utf-8"?>
<!-- Admin: Agregar pregunta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cira_fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/encabezado_admin" />

    <!-- El formulario tiene scroll por si el teclado tapa los campos -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etTextoPregunta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_campo"
                android:gravity="top|start"
                android:hint="Texto de la pregunta"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="@color/cira_texto"
                android:textColorHint="@color/cira_texto_suave"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Opciones (marca la correcta)"
                android:textColor="@color/cira_texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOpcionA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cira_verde" />

                <EditText
                    android:id="@+id/etOpcionA"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_campo"
                    android:hint="Opción A"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/cira_texto"
                    android:textColorHint="@color/cira_texto_suave"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOpcionB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cira_verde" />

                <EditText
                    android:id="@+id/etOpcionB"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_campo"
                    android:hint="Opción B"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/cira_texto"
                    android:textColorHint="@color/cira_texto_suave"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOpcionC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cira_verde" />

                <EditText
                    android:id="@+id/etOpcionC"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_campo"
                    android:hint="Opción C"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/cira_texto"
                    android:textColorHint="@color/cira_texto_suave"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbOpcionD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/cira_verde" />

                <EditText
                    android:id="@+id/etOpcionD"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_campo"
                    android:hint="Opción D"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/cira_texto"
                    android:textColorHint="@color/cira_texto_suave"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="¿La pregunta lleva imagen?"
                android:textColor="@color/cira_texto"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipConImagen"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_opcion_si_no"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Sí, lleva imagen"
                    android:textColor="@color/cira_texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipSoloTexto"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_opcion_si_no"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="No, solo texto"
                    android:textColor="@color/cira_texto"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Solo se ve si eligió "Sí, lleva imagen" -->
            <LinearLayout
                android:id="@+id/panelImagen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_marco_imagen"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgPrevia"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_redondo"
                    android:backgroundTint="@color/cira_verde_claro"
                    android:contentDescription="Imagen del residuo"
                    android:padding="28dp"
                    android:src="@drawable/ic_imagen"
                    android:tint="@color/cira_verde" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Imagen del residuo (solo si eliges Sí)"
                        android:textColor="@color/cira_texto"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnElegirImagen"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:text="Elegir imagen"
                        android:textAllCaps="false"
                        android:textColor="@color/cira_verde_oscuro"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="22dp"
                        app:strokeColor="@color/cira_verde"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:backgroundTint="@color/cira_verde"
        android:text="Guardar pregunta"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp" />
</LinearLayout>