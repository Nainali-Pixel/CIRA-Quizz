<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado común de las pantallas de administración: flecha de volver + título.
     El título se pone desde cada Activity con txtTituloAdmin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_redondo"
            android:backgroundTint="@color/cira_verde_claro"
            android:clickable="true"
            android:contentDescription="Volver"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_atras"
            android:tint="@color/cira_texto" />

        <TextView
            android:id="@+id/txtTituloAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/cira_texto"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cira_borde" />
</LinearLayout>