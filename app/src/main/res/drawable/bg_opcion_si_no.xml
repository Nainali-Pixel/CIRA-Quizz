<?xml version="1.0" encoding="utf-8"?>
<!-- Botones "Sí, lleva imagen" / "No, solo texto": seleccionado = verde claro con borde grueso -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cira_verde_claro" />
            <stroke android:width="2dp" android:color="@color/cira_verde" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1.5dp" android:color="@color/cira_verde" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>